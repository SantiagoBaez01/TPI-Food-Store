# Conexión a la base. PostgreSQL 15 o superior:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodstore_db
# Para desarrollo local sin PostgreSQL se acepta SQLite:
# DATABASE_URL=sqlite:///./foodstore.db

# Firma del JWT: mínimo 32 caracteres. Cambiarla en cada instalación.
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
# Algoritmo de firma del JWT
ALGORITHM=HS256
# Expiración del token y de la cookie access_token, en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Origen del frontend permitido por CORS (se admiten varios separados por coma)
FRONTEND_ORIGIN=http://localhost:5173
